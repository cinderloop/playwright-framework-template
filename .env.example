# Copy to .env and fill in. Real environment variables take precedence over .env.
# Validated at startup by src/app/config; a missing or invalid value fails the run immediately.

# Target environment: local (Toolshop in Docker, see docker-compose.yml) or public (practicesoftwaretesting.com)
TEST_ENV=local

# Optional overrides of the per-environment defaults in src/app/config/index.ts
# BASE_URL=http://localhost:4200
# API_URL=http://localhost:8091

# Accounts per role. Toolshop's seeded demo accounts are listed in its README:
# https://github.com/testsmith-io/practice-software-testing#default-accounts
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
